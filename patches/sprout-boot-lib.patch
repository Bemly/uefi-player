 test = false
+
+# Embedder overlay (parent repo patches/): expose the same sources as a lib
+# so downstream crates can call autoconfigure/generators/actions directly.
+# Upstream ships bin-only; without this Cargo silently ignores the dependency.
+[lib]
+name = "edera_sprout_boot"
