+fn test_yuv420_to_rgba_dual_path_reference() {
+    fn reference(y: u8, cb: u8, cr: u8) -> [u8; 4] {
+        let y = y as i32 - 16;
+        let cb = cb as i32 - 128;
+        let cr = cr as i32 - 128;
+        let gray = y * 76309;
+        let r = (gray + cr * 104597 + 32768) >> 16;
+        let g = (gray + cr * -53279 + cb * -25675 + 32768) >> 16;
+        let b = (gray + cb * 132201 + 32768) >> 16;
+        [
+            r.clamp(0, 255) as u8,
+            g.clamp(0, 255) as u8,
+            b.clamp(0, 255) as u8,
+            255,
+        ]
+    }
