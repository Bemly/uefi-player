+    let rgba = yuv420_to_rgba(&y, &cb, &cr, 5);
+    assert_eq!(rgba.len(), 15 * 4);
+
+    let mut expected = vec![0u8; 15 * 4];
+    for row in 0..3 {
+        for x in 0..5 {
+            let px = reference(
+                y[row * 5 + x],
+                cb[(row / 2) * 3 + x / 2],
+                cr[(row / 2) * 3 + x / 2],
+            );
+            expected[(row * 5 + x) * 4..(row * 5 + x) * 4 + 4].copy_from_slice(&px);
+        }
+    }
+    assert_eq!(rgba, expected);
