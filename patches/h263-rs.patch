 license = "MIT OR Apache-2.0"
 
+# NOTE(uefi-player vendor): vendored from ruffle-rs/h263-rs + no_std port.
+# See ../VENDOR.md. `std` (default on) preserves upstream behavior exactly
+# (wide SIMD fast paths, always on like upstream);
+# `default-features = false` is the firmware shape: no_std + alloc, every edge
+# filtered by the scalar kernel; add `simd` for the firmware SIMD shape (wide
+# without `std` — wide itself is `#![no_std]`, runtime-gated by
+# `set_simd_enabled`).
+
+[features]
+default = ["std"]
+# `simd`: wide integer kernels + 8-row zipping without `std` (wide itself is
+# `#![no_std]`; its `std` feature only speeds up float `sqrt`, which these
+# kernels never touch — see VENDOR.md). On => SIMD fast paths under the
+# runtime `simd_enabled` switch (single-bit `[accel]` backer, scalar=off/
+# else=on; defaults ON under `std` like upstream, OFF under no_std fail-closed
+# until firmware opts in). Off => scalar twin covering the identical edges.
+# `itertools` keeps `use_alloc` as its baseline so the no_std build stays
+# compiling; `use_std` is only layered on top for the std shape.
+simd = ["dep:wide", "dep:itertools"]
+std = ["simd", "wide/std", "itertools/use_std"]
+
 [dependencies]
-wide = "1.7.1"
-itertools = "0.15.0"
\ No newline at end of file
+wide = { version = "1.7.1", default-features = false, optional = true }
+itertools = { version = "0.15.0", default-features = false, features = ["use_alloc"], optional = true }
