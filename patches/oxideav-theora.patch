 keywords = ["multimedia", "video", "theora", "codec", "pure-rust"]
 categories = ["multimedia::encoding", "multimedia::video"]
 
+# NOTE(uefi-player vendor): vendored from crates.io 0.0.12 + no_std port (scalar).
+# See VENDOR.md. `std` (default on) preserves upstream behavior exactly;
+# `default-features = false` is the firmware shape: no_std + alloc, decoder-only.
+# `framework` (default on) pulls the std-only `oxideav-core` glue
+# (TheoraDecoder/TheoraEncoder/register); firmware leaves it off.
+# `encoder` (default on) keeps FrameEncoder + rate control; it implies `std`
+# (its rate-model fit uses f64 `.ln()` — libm or a port is a follow-up).
+# Bad combos are impossible by construction: framework/encoder each imply std.
+# `simd` (implied by `std`) keeps the SSE2 integer kernels in every shape
+# (wide itself is `#![no_std]`), runtime-gated by `simd::set_simd_enabled`.
+# Firmware shape: `--no-default-features --features simd` (see VENDOR.md for
+# the `[accel]` single-bit wiring contract — this crate never probes CPUID).
+
+[features]
+default = ["std", "framework", "encoder"]
+# Standard library. Off => `#![no_std]` + `alloc`; diagnostic prints become
+# no-ops and env knobs read as unset (no env use in this crate).
+# Upstream shape: SIMD on + wide's float fallback (mirrors the in-tree
+# h263-rs boxes: `std` implies `simd`).
+std = ["simd", "wide/std"]
+# SSE2 integer twins of the §7.9/§7.10 hot paths (IDCT butterfly, dequant,
+# reconstruct add+clamp, loop-filter edges). On => SIMD fast paths under the
+# runtime `simd::set_simd_enabled` switch (single-bit `[accel]` backer,
+# scalar=off/else=on; defaults ON under `std` like the scalar verdict era,
+# OFF under no_std fail-closed until firmware opts in). Off => scalar twins.
+# `wide` itself is `#![no_std]` (its `std` feature only speeds up float
+# `sqrt`, which these integer kernels never touch — see VENDOR.md).
+simd = ["dep:wide"]
+# oxideav-core integration (Decoder/Encoder traits, CodecRegistry).
+# Requires std: upstream oxideav-core is std-only (thiserror/serde_json/Read).
+framework = ["dep:oxideav-core", "std"]
+# Inter-frame encoder (FrameEncoder + RD/motion/rate-control machinery).
+# Requires std for now: RateModel::x uses f64 `.ln()`, which has no core
+# equivalent (a libm follow-up would unlock a no_std encoder).
+encoder = ["std"]
+
 [dependencies]
-oxideav-core = "0.1"
+oxideav-core = { version = "0.1", optional = true }
+# VENDOR(uefi-player): SIMD wheel for the `simd` feature (same version the
+# in-tree h263-rs boxes already use, so no new lockfile entry). `wide` is
+# `#![no_std]`; default-features=false keeps the firmware shape std-free.
+wide = { version = "1.7.1", default-features = false, optional = true }
+
+[lib]
+name = "oxideav_theora"
+path = "src/lib.rs"
