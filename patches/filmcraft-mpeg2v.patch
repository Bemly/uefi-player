-fn dual(v: [i32; 2], dmv: [i32; 2], m: i32, e: i32) -> [i32; 2] {
-    let s = |x: i32| (x * m + (x > 0) as i32) >> 1;
-    [s(v[0]) + dmv[0], s(v[1]) + e + dmv[1]]
-}
