 [package]
 name = "filmcraft-mpeg2v"
+version = "0.10.0"
+edition = "2024"
+# VENDOR(uefi-player): upstream declares 1.95; measured floor on this tree is
+# 1.92 (checked 2026-10-21, both feature shapes + tests), so the vendor pins
+# the lower value per repo MSRV policy. Re-measure on every upstream sync.
+rust-version = "1.92"
+license = "MIT OR Apache-2.0"
+repository = "https://github.com/storytold/filmcraft"
 description = "Clean-room MPEG-2 video (ITU-T H.262 | ISO/IEC 13818-2) and MPEG-1 video (ISO/IEC 11172-2) decoder"
-version.workspace = true
-edition.workspace = true
-license.workspace = true
-rust-version.workspace = true
 
-[lints]
-workspace = true
+# NOTE(uefi-player vendor): vendored from git 70f0fc7a (2026-10-20) + no_std port
+# (scalar + `simd`). See VENDOR.md. `std` (default on) implies `simd` and
+# preserves upstream behavior within the pixel gate (fixed-point IDCT replaces
+# the `f32` path; see `src/idct.rs`); `default-features = false` is the
+# firmware shape: no_std + alloc, threads off, scalar twin only unless `simd`
+# is added back (the no_std + `simd` firmware SIMD shape).
+# Upstream is not on crates.io, so this is a path vendor, not a registry version.
 
 [features]
-default = ["threads"]
+default = ["std", "threads"]
+# Standard library. Off => `#![no_std]` + `alloc`. On => `simd` (the runtime
+# `set_simd_enabled` switch stays the single-bit `[accel]` backer in both).
+std = ["simd"]
+# Integer SSE2 kernels (`asm!` explicit vector registers, no intrinsics, no
+# float vectors, no AVX): fixed-point IDCT row pass + half-pixel `pavgb`
+# averaging in `predict`. Zero dependencies; `#![no_std]`-clean. On =>
+# fast path under the runtime `simd_enabled` switch (single-bit `[accel]`
+# backer, scalar=off/else=on; defaults ON under `std`, OFF under no_std
+# fail-closed until firmware opts in). Off => scalar twin only.
+simd = []
+# Slice-row parallelism via rayon (MPEG-2 slices; MPEG-1 slices always decode in
+# order). The firmware port leaves this off; `threads` without `std` is
+# rejected below by `compile_error!` (rayon needs std). `simd` without `std`
+# is the firmware SIMD shape and is explicitly allowed.
 threads = ["dep:rayon"]
 
 [dependencies]
-thiserror = { workspace = true }
-rayon = { workspace = true, optional = true }
-
-[dev-dependencies]
-filmcraft-testkit = { workspace = true }
+# Unconditional `default-features = false`: only `String` payloads are formatted,
+# so the `std` feature (Path/PathBuf conveniences) changes nothing.
+thiserror = { version = "2", default-features = false }
+# Unconditional: the two IDCT table sites call `libm::cos` in both std and no_std
+# builds (identical tables, minimal diff; already in the firmware closure via
+# rusty_h264-decoder).
+libm = "0.2"
+# Unconditional `Sync` one-time cells for the IDCT/VLC lookup tables
+# (`core::cell::OnceCell` is not `Sync`, so `static`s reject it; `spin::Once`
+# is behavior-identical single-init semantics in both builds; MIT, MSRV 1.38,
+# zero transitive deps with this feature set).
+spin = { version = "0.9", default-features = false, features = ["once"] }
+rayon = { version = "1", optional = true }
